# Puerto del servidor HTTP y WebSocket
PORT=3001

# Orígenes permitidos por CORS, separados por comas
CORS_ORIGIN=http://localhost:5173

# Pausa antes de que un bot juegue, en milisegundos
BOT_DELAY_MS=1200

# Tiempo que una partida sin jugadores conectados espera antes de cerrarse, en milisegundos
ROOM_IDLE_TIMEOUT_MS=300000

# debug | info | warn | error
LOG_LEVEL=info

# Mensajes por segundo que puede enviar una conexión antes de que se la cierre
MESSAGES_PER_SECOND=30

# Carpeta del frontend compilado. Si se indica, el servidor también sirve la web
# (en producción: frontend/dist, relativo a donde se arranca el servidor)
# STATIC_DIR=frontend/dist
